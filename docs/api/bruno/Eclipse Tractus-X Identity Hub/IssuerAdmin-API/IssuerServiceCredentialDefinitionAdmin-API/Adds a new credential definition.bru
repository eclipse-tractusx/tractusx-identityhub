meta {
  name: Adds a new credential definition.
  type: http
  seq: 2
}

post {
  url: {{ISSUER_ADMIN_PATH}}/v1beta/participants/{{PARTICIPANT_CONTEXT_ID}}/credentialdefinitions
  body: json
  auth: apikey
}

auth:apikey {
  key: X-Api-Key
  value: {{API_KEY}}
  placement: header
}

body:json {
  {
    "id": "example-credential-def",
    "credentialType": "ExampleCredential",
    "format": "vc11-sl2021/jwt",
    "jsonSchema": "{}",
    "attestations": [],
    "mappings": [
      {
        "input": "did",
        "output": "credentialSubject.id",
        "required": true
      },
      {
        "input": "holder_id",
        "output": "credentialSubject.holderIdentifier",
        "required": true
      }
    ],
    "validity": 31536000
  }
}
