meta {
  name: Un-Publish an (existing) DID document. The DID is expected to exist in the database.
  type: http
  seq: 5
}

post {
  url: {{IDENTITY_PATH}}/v1alpha/participants/{{PARTICIPANT_CONTEXT_ID}}/dids/unpublish
  body: json
  auth: apikey
}

auth:apikey {
  key: X-Api-Key
  value: {{API_KEY}}
  placement: header
}

body:json {
  {
    "did": "{{DID_PLAIN}}"
  }
}

docs {
  Un-publishing requires the ParticipantContext to be in DEACTIVATED state first
  (POST /participants/{id}/state?isActive=false) - on an ACTIVATED participant
  this request returns 400.
}
