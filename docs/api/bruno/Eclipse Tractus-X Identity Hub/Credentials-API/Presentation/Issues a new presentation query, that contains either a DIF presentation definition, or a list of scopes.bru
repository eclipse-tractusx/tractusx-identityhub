meta {
  name: Issues a new presentation query, that contains either a DIF presentation definition, or a list of scopes
  type: http
  seq: 2
}

post {
  url: {{CREDENTIAL_PATH}}/v1/participants/{{PARTICIPANT_CONTEXT_ID}}/presentations/query
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{SI_TOKEN}}
}

body:json {
  {
    "@context": [
      "https://w3id.org/dspace-dcp/v1.0/dcp.jsonld"
    ],
    "type": "PresentationQueryMessage",
    "presentationDefinition": null,
    "scope": [
      "org.eclipse.tractusx.vc.type:MembershipCredential:read"
    ]
  }
}
