meta {
  name: Verify Negotiation Status
  type: http
  seq: 3
}

get {
  url: {{CONSUMER_MANAGEMENT}}/v3/contractnegotiations/{{negotiation-id}}
  body: none
  auth: apikey
}

headers {
  Accept: application/json
}

auth:apikey {
  key: X-Api-Key
  value: {{CONSUMER_API_KEY}}
  placement: header
}

script:pre-request {
  // Contract negotiation is asynchronous (REQUESTED -> AGREED -> VERIFYING -> FINALIZED).
  // Wait for it to reach FINALIZED so contractAgreementId is populated before we read it.
  await new Promise(resolve => setTimeout(resolve, 12000));
}

script:post-response {
  const contractId = res.getBody()['contractAgreementId'];
  bru.setEnvVar("contractId", contractId);
}

settings {
  encodeUrl: true
  timeout: 0
}
