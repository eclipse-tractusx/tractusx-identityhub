meta {
  name: Get Consumer DID Doc
  type: http
  seq: 4
}

get {
  url: {{CONSUMER_IDHUB_DID_API}}
  body: none
  auth: none
}

script:pre-request {
  // Resolve the did:web document location from the DID and set the Host header the
  // did:web server expects: did:web:host:seg1:seg2 -> {DID_API}/seg1/seg2/did.json (Host: host).
  const did = bru.getEnvVar("CONS_ID");
  const parts = did.replace("did:web:", "").split(":");
  const host = parts[0];
  const path = parts.slice(1).join("/");
  req.setUrl(bru.getEnvVar("CONSUMER_IDHUB_DID_API") + "/" + path + "/did.json");
  req.setHeader("Host", host);
}

settings {
  encodeUrl: true
  timeout: 0
}
