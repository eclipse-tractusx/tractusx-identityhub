meta {
  name: Verify Consumer Credentials
  type: http
  seq: 1
}

get {
  url: {{CONSUMER_IDHUB_ID_API}}/v1alpha/credentials
  body: none
  auth: none
}

headers {
  x-api-key: {{CONSUMER_IH_APIKEY}}
}

script:pre-request {
  // DCP credential issuance is asynchronous: the issuer's IssuanceProcess delivers the
  // MembershipCredential to the holder's CredentialService after the credential request is
  // accepted (201). On a multi-node deployment (umbrella) delivery is not instant, so wait
  // before verifying/presenting the credential.
  await new Promise(resolve => setTimeout(resolve, 25000));
}

settings {
  encodeUrl: true
  timeout: 0
}
